# ===   Pointage — Backend ===

# Sécurité (changer en prod, Render génère automatiquement via generateValue)
SECRET_KEY=change-me-in-production

# Token expiration (minutes)
TOKEN_EXPIRE_MINUTES=60

# Mode déploiement : "local" (LAN) ou "demo" (cloud Supabase/Render)
DEPLOY_MODE=local

# --- PostgreSQL (Supabase) ---
# URL pooler PgBouncer (port 6543) — utilisée par l'app en runtime
# DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west.pooler.supabase.com:6543/postgres
#
# URL directe (port 5432) — utilisée UNIQUEMENT pour les migrations Alembic
# DATABASE_URL_DIRECT=postgresql://postgres.xxxxx:password@db.xxxxx.supabase.co:5432/postgres

# --- PostgreSQL local (docker-compose) ---
POSTGRES_USER=topoint
POSTGRES_PASSWORD=topoint_secret
POSTGRES_DB=topoint

# Sous-réseau autorisé (optionnel — auto-détecté si non défini)
# Ex: ALLOWED_SUBNETS=192.168.1.0/24

# CORS — origines autorisées (virgules), vide = "*" en local
# Ex: CORS_ORIGINS=https://topointage-mobile.onrender.com,https://topointage-admin.onrender.com
